 */

/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include "imx93.dtsi"

/ {
	model = "Embedian i.MX93 SMARC board";
	compatible = "embedian,imx93-smarc", "fsl,imx93";

	aliases {
		rtc0 = &pcf85063;
		ethernet1 = &fec;	/* Let eth1addr mac address pass from U-Boot EEPROM */
	 };

	chosen {
	#if defined(CONFIG_CONSOLE_SER3)
		bootargs = "console=ttyLP0,115200";
		stdout-path = &lpuart1;
	#endif
	#if defined(CONFIG_CONSOLE_SER2)
		bootargs = "console=ttyLP7,115200";
		stdout-path = &lpuart8;
	#endif
	#if defined(CONFIG_CONSOLE_SER1)
		bootargs = "console=ttyLP1,115200";
		stdout-path = &lpuart2;
	#endif
	#if defined(CONFIG_CONSOLE_SER0)
		bootargs = "console=ttyLP5,115200";
		stdout-path = &lpuart6;
	#endif
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0 0x80000000 0 0x40000000>;
			size = <0 0x10000000>;
			linux,cma-default;
		};
	};

	reg_can1_stby: regulator-can1-stby {
		compatible = "regulator-fixed";
		regulator-name = "can1-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	reg_can2_stby: regulator-can2-stby {
		compatible = "regulator-fixed";
		regulator-name = "can2-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	reg_usb_vbus: regulator-vbus {
		compatible = "regulator-fixed";
		regulator-name = "USB_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pcal6524_a 18 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	reg_usdhc2_vmmc: regulator-usdhc2 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
		regulator-name = "VSD_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio3 7 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

	dsi_host: dsi-host {
		compatible = "synopsys,dw-mipi-dsi";
		status = "disabled";
	};

	rm67199_panel {
		compatible = "raydium,rm67199";
		dsi-lanes = <4>;
		video-mode = <2>;	/* 0: burst mode
					 * 1: non-burst mode with sync event
					 * 2: non-burst mode with sync pulse
					 */
		width-mm = <68>;
		height-mm = <121>;
		status = "disabled";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dphy {
	status = "disabled";
};

&dsi {
	status = "disabled";

	ports {
		port@1 {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&mu1 {
	status = "okay";
};

&mu2 {
	status = "okay";
};

&eqos {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_eqos>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy1>;
	status = "okay";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <5000000>;

		ethphy1: ethernet-phy@1 {
			reg = <1>;
			eee-broken-1000t;
		};
	};
};

&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy2>;
	fsl,magic-packet;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		clock-frequency = <5000000>;

		ethphy2: ethernet-phy@2 {
			reg = <2>;
			eee-broken-1000t;
		};
	};
};

&lcdif {
	status = "disabled";

	assigned-clock-rates = <484000000>, <121000000>, <400000000>, <133333333>;
};

/* I2C_PM */
&lpi2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	pinctrl-1 = <&pinctrl_lpi2c2>;
	status = "okay";

	pmic@25 {
		compatible = "nxp,pca9451a";
		reg = <0x25>;
		interrupt-parent = <&pcal6524_a>;
		interrupts = <11 IRQ_TYPE_EDGE_FALLING>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <2237500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck4: BUCK4{
				regulator-name = "BUCK4";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: BUCK5{
				regulator-name = "BUCK5";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck6: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	/*
	 * PCAL6524 24-port GPIO expander
	 *  0-W_DISABLE1#
	 *  1-SD_INT#
	 *  2-WL_RESET#
	 *  3-BT_RESET#
	 *  4-WL_WAKE_OUT#
	 *  5-BT_WAKE_OUT#
	 *  6-WL_WAKE_IN#
	 *  7-BT_WAKE_IN#
	 *  8-TPM_IRQ#
	 *  9-TPM_PP#
	 * 10-SD2_WP#
	 * 11-PMIC_INT#
	 * 12-WLAN_PWR_EN
	 * 13-ENET1_INT#
	 * 14-ENET2_INT#
	 * 15-x
	 * 16-SPI0_CS1
	 * 17-eSPI_CS1
	 * 18-USB1_EN
	 * 19-USB1_OC#
	 * 20-LCD0_VDD_EN
	 * 21-LCD0_BKLT_EN
	 * 22-LCD1_VDD_EN
	 * 23-LCD1_BKLT_EN
	 */
	pcal6524_a: gpio@22 {
		compatible = "nxp,pcal6524";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6524_a>;
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;

		w_disable1_hog {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "w_disable1";
		};

		sd_int_hog {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_LOW>;
			input;
			line-name = "sd_int";
		};

		wl_reset_hog {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "wl_reset";
		};

		bt_reset_hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_LOW>;
			output-high;
			line-name = "bt_reset";
		};

		wl_wake_out_hog {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "wl_wake_out";
		};

		bt_wake_out_hog {
			gpio-hog;
			gpios = <5 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "bt_wake_out";
		};

		wl_wake_in_hog {
			gpio-hog;
			gpios = <6 GPIO_ACTIVE_LOW>;
			input;
			line-name = "wl_wake_in";
		};

		bt_wake_in_hog {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_LOW>;
			input;
			line-name = "bt_wake_in";
		};

		tpm_irq_hog {
			gpio-hog;
			gpios = <8 GPIO_ACTIVE_LOW>;
			input;
			line-name = "tpm_irq";
		};

		tpm_pp_hog {
			gpio-hog;
			gpios = <9 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "tpm_pp";
		};

		sd2_wp_hog {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "sd2_wp";
		};

		pmic_int_hog {
			gpio-hog;
			gpios = <11 GPIO_ACTIVE_LOW>;
			input;
			line-name = "pmic_int";
		};

		enet1_int_hog {
			gpio-hog;
			gpios = <13 GPIO_ACTIVE_LOW>;
			input;
			line-name = "enet1_init";
		};

		enet2_int_hog {
			gpio-hog;
			gpios = <14 GPIO_ACTIVE_LOW>;
			input;
			line-name = "enet2_init";
		};

		usb0_en_hog {
			gpio-hog;
			gpios = <18 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "usb0_en";
		};

		usb0_oc_hog {
			gpio-hog;
			gpios = <19 GPIO_ACTIVE_LOW>;
			input;
			line-name = "usb0_oc";
		};

		/*lcd0_vdd_en_hog {
			gpio-hog;
			gpios = <20 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "lcd0_vdd_en";
		};*/

		/*lcd0_bklt_en_hog {
			gpio-hog;
			gpios = <21 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "lcd0_bklt_en";
		};

		lcd1_vdd_en_hog {
			gpio-hog;
			gpios = <22 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "lcd1_vdd_en";
		};

		lcd1_bklt_en_hog {
			gpio-hog;
			gpios = <23 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "lcd1_bklt_en";
		};*/
	};

	/*
	 * PCAL6524 24-port GPIO expander
	 *  0-GPIO0
	 *  1-GPIO1
	 *  2-GPIO2
	 *  3-GPIO3
	 *  4-GPIO4
	 *  5-GPIO6
	 *  6-GPIO7
	 *  7-GPIO8
	 *  8-GPIO9
	 *  9-GPIO10
	 * 10-GPIO11
	 * 11-GPIO12
	 * 12-GPIO13
	 * 13-x
	 * 14-x
	 * 15-IMX_RESET_OUT
	 * 16-LID#
	 * 17-SLEEP#
	 * 18-CHARGING#
	 * 19-BATLOW#
	 * 20-CHARGER_PRSNT#
	 * 21-BOOT_SEL0#
	 * 22-BOOT_SEL1#
	 * 23-BOOT_SEL2#
	 */
	pcal6524_b: gpio@23 {
		compatible = "nxp,pcal6524";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6524_b>;
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio2>;
		interrupts = <18 IRQ_TYPE_LEVEL_LOW>;

		gpio0_hog {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "gpio0";
		};

		gpio1_hog {
			gpio-hog;
			gpios = <1 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "gpio1";
		};

		gpio2_hog {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "gpio2";
		};

		gpio3_hog {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "gpio3";
		};

		gpio4_hog {
			gpio-hog;
			gpios = <4 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "gpio4";
		};

		gpio6_hog {
			gpio-hog;
			gpios = <5 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio6";
		};

		gpio7_hog {
			gpio-hog;
			gpios = <6 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio7";
		};

		gpio8_hog {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio8";
		};

		gpio9_hog {
			gpio-hog;
			gpios = <8 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio9";
		};

		gpio10_hog {
			gpio-hog;
			gpios = <9 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio10";
		};

		gpio11_hog {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio11";
		};

		gpio12_hog {
			gpio-hog;
			gpios = <11 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio12";
		};

		gpio13_hog {
			gpio-hog;
			gpios = <12 GPIO_ACTIVE_HIGH>;
			input;
			line-name = "gpio13";
		};

		imx_reset_out_hog {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "imx_reset_out";
		};

		lid_hog {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_LOW>;
			input;
			line-name = "lid";
		};

		sleep_hog {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_LOW>;
			input;
			line-name = "sleep";
		};

		charging_hog {
			gpio-hog;
			gpios = <18 GPIO_ACTIVE_LOW>;
			input;
			line-name = "charging";
		};

		batlow_hog {
			gpio-hog;
			gpios = <19 GPIO_ACTIVE_LOW>;
			input;
			line-name = "batlow";
		};

		charger_prsnt_hog {
			gpio-hog;
			gpios = <20 GPIO_ACTIVE_LOW>;
			input;
			line-name = "charger_prsnt";
		};

		boot_sel0_hog {
			gpio-hog;
			gpios = <21 GPIO_ACTIVE_LOW>;
			input;
			line-name = "boot_sel0";
		};

		boot_sel1_hog {
			gpio-hog;
			gpios = <22 GPIO_ACTIVE_LOW>;
			input;
			line-name = "boot_sel1";
		};

		boot_sel2_hog {
			gpio-hog;
			gpios = <23 GPIO_ACTIVE_LOW>;
			input;
			line-name = "boot_sel2";
		};
	};

	pcf85063: rtc@51 {
		compatible = "nxp,pcf85063";
		reg = <0x51>;
	};

	cape_eeprom0: cape_eeprom@57 {
		compatible = "at,24c256";
		reg = <0x57>;
	};
};

/* I2C_CAM0 */
&lpi2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c1>;
	pinctrl-1 = <&pinctrl_lpi2c1>;
	status = "okay";
};

/* I2C_GP */
&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3>;
	status = "okay";

	baseboard_eeprom: baseboard_eeprom@50 {
		compatible = "at,24c256";
		reg = <0x50>;
	};
};

/* I2C_LCD */
&lpi2c5 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	pinctrl-1 = <&pinctrl_lpi2c5>;
	status = "okay";
};

&lpuart6 { /* SER0 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart6>;
	status = "okay";
};

&lpuart2 { /* SER1 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	status = "okay";
};

&lpuart8 { /* SER2 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart8>;
	status = "okay";
};

&lpuart1 { /* console, SER3 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

/* SPI0 */
&lpspi3 {
	fsl,spi-num-chipselects = <2>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi3>;
	cs-gpios = <&gpio2 8 GPIO_ACTIVE_LOW>, <&pcal6524_a 16 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev0: spi@0 {
		reg = <0>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};

	spidev1: spi@1 {
		reg = <1>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};
};

/* eSPI */
&lpspi6 {
	fsl,spi-num-chipselects = <2>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi6>;
	cs-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>, <&pcal6524_a 17 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev2: spi@0 {
		reg = <0>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};

	spidev3: spi@1 {
		reg = <1>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};
};

&media_blk_ctrl {
	status = "okay";
};

&usbotg1 {
	vbus-supply = <&reg_usb_vbus>;
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	disable-over-current;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
	status = "okay";
};

&usbotg2 {
	dr_mode = "host";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	disable-over-current;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
	status = "okay";
};

&usdhc1 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	bus-width = <8>;
	non-removable;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_usdhc2_vmmc>;
	bus-width = <4>;
	status = "okay";
	no-sdio;
	no-mmc;
};

&usdhc3 {
	status = "disabled";
};



&flexspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexspi>;
	assigned-clock-rates = <80000000>;
	status = "okay";

	flash0: flash@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <80000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&iomuxc {
	pinctrl_flexcan2: flexcan2grp {
		fsl,pins = <
			MX93_PAD_GPIO_IO25__CAN2_TX	0x139e
			MX93_PAD_GPIO_IO27__CAN2_RX	0x139e
		>;
	};

	/* I2C_CAM0 */
	pinctrl_lpi2c1: lpi2c1grp {
